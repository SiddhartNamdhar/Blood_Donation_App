<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BloodBank">

        <!-- Splash Activity (Launcher) -->
        <activity
            android:name=".SplashActivity"
            android:theme="@style/Theme.BloodBank.Splash"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Onboarding Activity -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="false" />

        <!-- Staff Authentication Activity -->
        <activity
            android:name=".StaffAuthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Donor Authentication Activity -->
        <activity
            android:name=".DonorAuthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Donor Dashboard Activity -->
        <activity
            android:name=".DonorActivity"
            android:exported="false" />

        <!-- Staff Portal (Main Activity) -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>