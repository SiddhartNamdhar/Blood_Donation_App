<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/midnight_surface_elevated" />
            <corners android:radius="@dimen/radius_sm" />
            <stroke
                android:width="@dimen/card_stroke_active_width"
                android:color="@color/blood_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/midnight_surface" />
            <corners android:radius="@dimen/radius_sm" />
            <stroke
                android:width="@dimen/card_stroke_width"
                android:color="@color/midnight_stroke" />
        </shape>
    </item>
</selector>
